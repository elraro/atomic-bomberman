# Settings of the online service (docker-compose.yml). Copy to .env, or let ./setup.sh do
# it; after a change run ./setup.sh again, then: docker compose up -d

# The name players' games reach this machine by, and its public address.
DOMAIN=master.example.org
PUBLIC_IP=203.0.113.10
# The names of the master and of the relay, where they differ from DOMAIN (with a proxy
# they must differ from each other: the proxy tells them apart by name). Empty: DOMAIN.
MASTER_HOST=
TURN_HOST=
# The address the machine itself holds, where that is another one (a cloud machine whose
# public address is mapped onto a private one). Empty: the same as PUBLIC_IP.
PRIVATE_IP=

# Master server: HTTPS on this port (TCP). With a proxy: plain HTTP on PROXY_BIND:MASTER_PORT
# for the proxy only, and HTTPS on 443 through it.
MASTER_PORT=8443

# Relay (coturn): UDP and TCP on TURN_PORT, TLS on TURN_TLS_PORT (443 passes where only
# HTTPS does; with a proxy, 443 is the proxy's), relayed traffic on UDP TURN_MIN_PORT-TURN_MAX_PORT.
TURN_PORT=3478
TURN_TLS_PORT=443
TURN_MIN_PORT=5000
TURN_MAX_PORT=9999

# What stands in front of the master and the relay's TLS port:
#   (empty)   nothing: they show a certificate signed by itself, named in the configuration
#             by the pin of its key (data/master/master.crt)
#   traefik   Traefik is started here on 443 (traefik.yml) and gets certificates from Let's
#             Encrypt for MASTER_HOST and TURN_HOST; ACME_EMAIL is needed
#   external  a Traefik you run already: give it data/traefik/atomic.yml (written by setup.sh)
# With a proxy the configuration names Let's Encrypt's roots (letsencrypt/isrg-roots.pem)
# instead of a pin. After a change: delete data/config.json and run ./setup.sh again.
PROXY=
# Let's Encrypt's notices about the certificates (expiry, problems) go to this address.
ACME_EMAIL=
# Where the master listens for the proxy (it must reach it there; 127.0.0.1 for Traefik
# on this machine's network, as traefik.yml runs it).
PROXY_BIND=127.0.0.1
# The names of Traefik's entry point on 443 and of its Let's Encrypt resolver, in the routes
# setup.sh writes (for PROXY=external: the names your Traefik uses). An empty resolver: the
# routes ask for none, and Traefik shows its default certificate.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_RESOLVER=letsencrypt
# The certificates of authorities the configuration names for the master and the relay
# with a proxy (a PEM file, relative to this folder).
TLS_ROOTS_FILE=letsencrypt/isrg-roots.pem

# PostgreSQL is reachable from this machine only, on this port.
POSTGRES_PORT=5432

# Lowest protocol version of the game that is let in. Empty: the version of this source
# tree (kProtocolVersion in src/net/protocol.hpp).
PROTOCOL_MIN=

# Dedicated game server (optional: docker compose --profile gameserver up -d).
GAME_NAME=Atomic Bomberman
GAME_PORT=27410
# listed (in the list for everybody) or code (found by its six digits only)
GAME_ONLINE=listed
# Any further options of atomic_server (atomic_server --help), e.g. --wins 3 --computers 0
GAME_OPTIONS=

# Which images: latest (the main branch) or a release such as v1.1. They are published at
# ghcr.io/elraro/atomic-bomberman-master and -server; built here where not pulled.
IMAGE_TAG=latest

# Filled in by ./setup.sh.
ONLINE_CONFIG_URL=
POSTGRES_PASSWORD=
TURN_SECRET=
ONLINE_KEY=
HOST_UID=
HOST_GID=
