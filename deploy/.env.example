# Settings of the online service (docker-compose.yml). Copy to .env, or let ./setup.sh do
# it; after a change run ./setup.sh again, then: docker compose up -d

# The name players' games reach this machine by, and its public address.
DOMAIN=master.example.org
PUBLIC_IP=203.0.113.10
# The address the machine itself holds, where that is another one (a cloud machine whose
# public address is mapped onto a private one). Empty: the same as PUBLIC_IP.
PRIVATE_IP=

# Master server: HTTPS on this port (TCP).
MASTER_PORT=8443

# Relay (coturn): UDP and TCP on TURN_PORT, TLS on TURN_TLS_PORT (443 passes where only
# HTTPS does), relayed traffic on UDP TURN_MIN_PORT-TURN_MAX_PORT.
TURN_PORT=3478
TURN_TLS_PORT=443
TURN_MIN_PORT=5000
TURN_MAX_PORT=9999

# PostgreSQL is reachable from this machine only, on this port.
POSTGRES_PORT=5432

# Lowest protocol version of the game that is let in. Empty: the version of this source
# tree (kProtocolVersion in src/net/protocol.hpp).
PROTOCOL_MIN=

# Dedicated game server (optional: docker compose --profile gameserver up -d).
GAME_NAME=Atomic Bomberman
GAME_PORT=27410
# listed (in the list for everybody) or code (found by its six digits only)
GAME_ONLINE=listed
# Any further options of atomic_server (atomic_server --help), e.g. --wins 3 --computers 0
GAME_OPTIONS=

# Which images: latest (the main branch) or a release such as v1.1. They are published at
# ghcr.io/elraro/atomic-bomberman-master and -server; built here where not pulled.
IMAGE_TAG=latest

# Filled in by ./setup.sh.
POSTGRES_PASSWORD=
TURN_SECRET=
ONLINE_KEY=
HOST_UID=
HOST_GID=
